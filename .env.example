# Sharepointer - Environment Variables
# =====================================
# Copy this file to .env and fill in your values

# Admin Dashboard API Key
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=your-random-64-char-hex-string-here

# Cookie Encryption Secret (REQUIRED)
# Generate with: openssl rand -hex 32
# Used to encrypt session cookies containing Azure credentials
COOKIE_SECRET=your-random-64-char-hex-string-here

# Optional: Node Environment (defaults to development)
# NODE_ENV=production

# =====================================
# Setup Instructions
# =====================================
# 1. Copy this file: cp .env.example .env
# 2. Generate ADMIN_API_KEY: openssl rand -hex 32
# 3. Generate COOKIE_SECRET: openssl rand -hex 32
# 4. Start server: npm run dev
# 5. Configure Azure credentials via browser UI at http://localhost:3000

# =====================================
# Notes
# =====================================
# - NO Azure credentials needed in .env
# - Users configure their own Azure App Registration via web UI
# - Credentials stored in encrypted session cookies
# - COOKIE_SECRET must be kept secret and never committed to git
