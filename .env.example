# Environment Configuration
# Copy this file to .env and fill in your actual values

# NOTE: Azure credentials are NO LONGER set via environment variables!
# Users configure their own Azure App Registration via the web interface.
# See docs/LOGGING.md for the browser-based configuration flow.

# Admin API Key for /api/logs endpoint access
# Generate a secure key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=your-secure-admin-key-change-me

# Application Settings
PORT=3000
REDIRECT_URI=http://localhost:3000/auth/callback

# Microsoft Graph API
GRAPH_API_URL=https://graph.microsoft.com/v1.0