# Sharepointer - Environment Variables Template
# =============================================
# BELANGRIJK: Dit bestand bevat GEEN echte credentials
# Kopieer naar .env en vul je eigen waarden in

# ==============================================================================
# GEEN AZURE CREDENTIALS NODIG!
# ==============================================================================
# Sharepointer is stateless en browser-based. Gebruikers voeren hun eigen 
# Azure App Registration credentials in via de web UI.
# 
# Enige uitzondering: als je server-side features wilt gebruiken die niet via
# browser auth kunnen (bijv. scheduled jobs), dan kun je onderstaande invullen.

# Server Configuration (optioneel)
PORT=3000
NODE_ENV=development

# Admin Dashboard (optioneel - alleen voor lokale dev)
# Genereer nieuwe key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=your_admin_api_key_here

# ==============================================================================
# LEGACY: Server-side Azure credentials (NIET AANBEVOLEN)
# ==============================================================================
# Onderstaande variabelen zijn NIET nodig voor normale browser-based flow.
# Enkel invullen als je server-side Graph API calls wilt maken zonder user context.

# TENANT_ID=your_tenant_id_here
# CLIENT_ID=your_client_id_here
# CLIENT_SECRET=your_client_secret_here
# REDIRECT_URI=http://localhost:3000/auth/callback
# GRAPH_API_URL=https://graph.microsoft.com/v1.0

# ==============================================================================
# PRODUCTIE DEPLOYMENT
# ==============================================================================
# Voor productie deployment op sharepointer.be:
# 1. Zet NODE_ENV=production
# 2. Genereer nieuwe ADMIN_API_KEY
# 3. Configureer HTTPS redirect URI in Azure: https://sharepointer.be/
# 4. GEEN credentials in .env - alles via browser-based config!
